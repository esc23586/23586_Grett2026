                                 /*
                                 * NombreProgra.asm
                                 *
                                 * Creado: 
                                 * Autor : Grettel Escobedo 23586
                                 * Descripción: Base para la creación de la maquina de Estados para el proyuecto 1, reloj. 
                                 
                                 *Se identifica, 6 estados, entones el  limite o overflow debe de ser de 7. 
                                 *Se utilizará el timer 1 en este caso. 
                                 */
                                 /*****************************************************************************************************************************************/
                                 // Encabezado (Definición de Registros, Variables y Constantes)
                                 .include "M328PDEF.inc"     // Include definitions specific to ATMega328P
                                 
                                 ;***** Created: 2011-02-09 12:03 ******* Source: ATmega328P.xml **********
                                 ;*************************************************************************
                                 ;* A P P L I C A T I O N   N O T E   F O R   T H E   A V R   F A M I L Y
                                 ;* 
                                 ;* Number            : AVR000
                                 ;* File Name         : "m328Pdef.inc"
                                 ;* Title             : Register/Bit Definitions for the ATmega328P
                                 ;* Date              : 2011-02-09
                                 ;* Version           : 2.35
                                 ;* Support E-mail    : avr@atmel.com
                                 ;* Target MCU        : ATmega328P
                                 ;* 
                                 ;* DESCRIPTION
                                 ;* When including this file in the assembly program file, all I/O register 
                                 ;* names and I/O register bit names appearing in the data book can be used.
                                 ;* In addition, the six registers forming the three data pointers X, Y and 
                                 ;* Z have been assigned names XL - ZH. Highest RAM address for Internal 
                                 ;* SRAM is also defined 
                                 ;* 
                                 ;* The Register names are represented by their hexadecimal address.
                                 ;* 
                                 ;* The Register Bit names are represented by their bit number (0-7).
                                 ;* 
                                 ;* Please observe the difference in using the bit names with instructions
                                 ;* such as "sbr"/"cbr" (set/clear bit in register) and "sbrs"/"sbrc"
                                 ;* (skip if bit in register set/cleared). The following example illustrates
                                 ;* this:
                                 ;* 
                                 ;* in    r16,PORTB             ;read PORTB latch
                                 ;* sbr   r16,(1<<PB6)+(1<<PB5) ;set PB6 and PB5 (use masks, not bit#)
                                 ;* out   PORTB,r16             ;output to PORTB
                                 ;* 
                                 ;* in    r16,TIFR              ;read the Timer Interrupt Flag Register
                                 ;* sbrc  r16,TOV0              ;test the overflow flag (use bit#)
                                 ;* rjmp  TOV0_is_set           ;jump if set
                                 ;* ...                         ;otherwise do something else
                                 ;*************************************************************************
                                 
                                 #ifndef _M328PDEF_INC_
                                 #endif  /* _M328PDEF_INC_ */
                                 
                                 ; ***** END OF FILE ******************************************************
                                 
                                 ;========================================
                                 ;           Variables/registros
                                 ;========================================
                                 .equ T1VALUE	= 0XC2F7
                                 .equ MAX_MODES		= 7; se coloca uno extra para que en el momento en el que hace el overflow.
                                 ; este nos ayuda a definir la cantidad de estados de la maquina. 
                                 
                                 ; val timers
                                 .equ			T1VALUE_L			= 0xDC
                                 .equ			T1VALUE_H			= 0x0B
                                 ;.equ			T1VALUE_L			= 0x06
                                 ;.equ			T1VALUE_H			= 0x00; revisar
                                 .equ			T0VALUE				= 6
                                 
                                 
                                 ; Bits característicos del registro "MODO":
                                 ;.equ			MODO_NUEVO1			= 7
                                 ;.equ			MODO_NUEVO0			= 6
                                 .equ			SETUP_VALUE			= 5
                                 .equ			BLINKSTATE			= 4
                                 .equ			SETUP_				= 3
                                 .equ			MODE_SELECT			= 2
                                 .equ			MODO1				= 1
                                 .equ			MODO0				= 0
                                 
                                 .def COUNTER	= R19; contador 
                                 .def ACTION		= R20;acción registrada.
                                 
                                 ; Bits característicos para mi registro "ENCODER":
                                 .equ			PB_LAST				= 2
                                 .equ			CAMBIO				= 1
                                 .equ			DIRECCION			= 0
                                 
                                 
                                 ; Bits característicos del registro "ALARM_REGISTER":
                                 ; esto todavia hay que verificarm, realmente solo quiero indicar por ahora. 
                                 /*
                                 .equ			ALARM_SET			= 0
                                 .equ			ALARM_ACTIVE		= 1
                                 .equ			ALARM_VALID			= 2
                                 */
                                 
                                 ; Bits característicos de PORTC:
                                 .equ			EN_PB				= 2
                                 .equ			EN0					= 3
                                 .equ			EN1					= 4
                                 .equ			SET_SPDT			= 5
                                 /*************************************************************************************************************************************/
                                 
                                 ; Localidades de memoria de mis datos; mejor orden.
                                 
                                 ; Variables de conteo
                                 .equ			MINUTOS_UNIDADES	= 0x0101
                                 .equ			MINUTOS_DECENAS		= 0x0102
                                 .equ			HORAS_UNIDADES		= 0x0103
                                 .equ			HORAS_DECENAS		= 0x0104
                                 .equ			DIAS_UNIDADES		= 0x0105
                                 .equ			DIAS_DECENAS		= 0x0106
                                 .equ			MESES_UNIDADES		= 0x0107
                                 .equ			MESES_DECENAS		= 0x0108
                                 
                                 ; NOTA: hay que indicar los de la alarma posteriormente: 
                                 ;(digamos que aqui los pondré)
                                 
                                 ; Variables de cada display
                                 .equ			DISPMODE_VALUE		= 0x0109
                                 .equ			DISP0_VALUE			= 0x010A
                                 .equ			DISP1_VALUE			= 0x010B
                                 .equ			DISP2_VALUE			= 0x010C
                                 .equ			DISP3_VALUE			= 0x010D
                                 
                                 ;NOTA 2:; Días de cada mes (Solo primera localidad para apuntar con el XPointer)
                                 .equ			DIAS_DE_MESES		= 0x0200
                                 
                                 
                                 ; memoria y etiquetas para las interrupciones:
                                 .cseg
                                 .org 0x0000
000000 940c 0048                 	JMP SETUP
                                 	
                                 .org PCI1addr ;Pin Change Interrupt 1 (PORTC)
000008 c5b2                      	RJMP	PINCHANGE_INTERRUPT
                                 
                                 .org OVF1addr; rutina del timer 1
00001a 940c 04f7                 	JMP  TIM1_INTERRUPT
                                 
                                 .org OVF0addr
000020 c4f3                      	RJMP TIM0_INTERRUPT
                                 
                                 ; Para facilidades guardamos una tabla para valores de DISP7SEG
                                 .org 0x0040
                                 	DISP7SEG:	
000040 063f
000041 4f5b
000042 6d66
000043 077d
000044 677f
000045 7c77
000046 5e39
000047 7179                      		.DB	0x3F, 0x06, 0x5B, 0x4F, 0x66, 0x6D, 0x7D, 0x07, 0x7F, 0x67, 0x77, 0x7C, 0x39, 0x5E, 0x79, 0x71
                                 /*********************************************************************************************************************************************/
                                 ; Registros de propósito general
                                 .def			msCOUNT0				= R20 
                                 .def			msCOUNT1				= R21
                                 .def			sCOUNT					= R22 
                                 .def			MODO					= R23
                                 .def			MUX_SECUENCIA			= R24
                                 .def			ENCODER					= R25
                                 ;***********************************************
                                 
                                 // Configuracion MCU
                                 SETUP:
                                     //disablle interruptions (clears I bit on sreg )
000048 94f8                      cli 
                                 /************* PRESCALER ************************************************************/
                                 //Configuración main clock prescaler 
000049 e004                      LDI R16, (1<<CLKPS2)
00004a 9300 0061                 STS CLKPR, R16 		;enable prescaler
00004c e004                      LDI R16, (1<<CLKPS2)
00004d 9300 0061                 STS CLKPR, R16 		;setear de 16 a 1MHZ
                                 
                                 
                                 ;--------Deshabilitar comunicación serial-------UART
00004f e000                      	LDI		R16, 0x00
000050 9300 00c1                 	STS		UCSR0B, R16
                                 
                                 // Configuración de la pila
000052 ef0f                      LDI     R16, LOW(RAMEND)
000053 bf0d                      OUT     SPL, R16
000054 e008                      LDI     R16, HIGH(RAMEND)
000055 bf0e                      OUT     SPH, R16
                                 
                                 ; Guardamos algunos valores en RAM
                                 
                                 	; Días de cada mes (Se le añade +1 a c/u para hacer la lógica correctamente)
000056 e0a0                      	LDI		XL, LOW(DIAS_DE_MESES)
000057 e0b2                      	LDI		XH, HIGH(DIAS_DE_MESES)
000058 e200                      	LDI		R16, 32 ;Enero: 31 días
000059 930d                      	ST		X+, R16
00005a e10d                      	LDI		R16, 29 ;Febrero: 28 días
00005b 930d                      	ST		X+, R16
00005c e200                      	LDI		R16, 32 ;Marzo: 31 días
00005d 930d                      	ST		X+, R16
00005e e10f                      	LDI		R16, 31 ;Abril: 30 días
00005f 930d                      	ST		X+, R16
000060 e200                      	LDI		R16, 32 ;Mayo: 31 días
000061 930d                      	ST		X+, R16
000062 e10f                      	LDI		R16, 31 ;Junio: 30 días
000063 930d                      	ST		X+, R16
000064 e200                      	LDI		R16, 32 ;Julio: 31 días
000065 930d                      	ST		X+, R16
000066 e200                      	LDI		R16, 32 ;Agosto: 31 días
000067 930d                      	ST		X+, R16 
000068 e10f                      	LDI		R16, 31 ;Septiembre: 30 días
000069 930d                      	ST		X+, R16
00006a e200                      	LDI		R16, 32 ;Octubre: 31 días
00006b 930d                      	ST		X+, R16
00006c e10f                      	LDI		R16, 31 ;Noviembre: 30 días
00006d 930d                      	ST		X+, R16
00006e e200                      	LDI		R16, 32 ;Diciembre: 31 días
00006f 930d                      	ST		X+, R16
                                 
                                 	; "-" para displays
                                 	/*
                                 	LDI		R16, 0x40
                                 	STS		DISP_GUION, R16
                                 	*/
                                 
                                 /************************************************************************************************************************************************/
                                 //CONFIGURACIÓN DE SALIDAS 
                                 ; --------------Configuración de los Pines para el puerto D-----
                                 	;Configurar I/O PORTS
000070 ef0f                      	LDI		R16, 0xFF			;0b11111111, se activaron todos, incluyendo el puntito.
000071 b90a                      	OUT		DDRD, R16			; Se les asigna a la dirección
                                 
000072 2700                      	CLR R16					; limpio mi variable (setear a cero)
000073 b90b                      	OUT PORTD, R16				; Les mando 0 voltios para empezar. 
                                 
                                 ;PORTB: BIN Out(se tutilizara un contador de 3, bits nomas) (PB0,1,2)
000074 e007                      	LDI		R16, 0b00000111
000075 b904                      	OUT		DDRB, R16
000076 e000                      	LDI		R16, 0x00
000077 b905                      	OUT		PORTB, R16
                                 
                                 	;PORTC: entradas para mi maquina (PC0,1,2,3)              | DISPSMUXOUT (PC4,5,6,7)
000078 ef00                      	LDI		R16, 0b11110000
000079 b907                      	OUT		DDRC, R16
00007a e00f                      	LDI		R16, 0b00001111 ;Comenzamos encendiendo DISPUNIS
00007b b908                      	OUT		PORTC, R16
                                 /*************************************************************************************************************************/
                                 
                                 ; Establecer TIM0 en modo Normal:
                                 	; Prescaler TIM0 = 64 
                                 	; TCNT0 = 6
                                 	; Activar Máscara
                                 	; Activar Bandera de INT
00007c e003                      	LDI		R16, (0 << CS02) |(1 << CS01) | (1 << CS00)
00007d bd05                      	OUT		TCCR0B, R16
00007e e001                      	LDI		R16, (1 << TOIE0) 
00007f 9300 006e                 	STS		TIMSK0, R16
000081 e006                      	LDI		R16, T0VALUE
000082 bd06                      	OUT		TCNT0, R16
                                 
                                 //CONFIGURACIÓN TIMER1;		
                                 ; Establecer TIM1 en modo Normal:
                                 	; Prescaler TIM0 = 256,TCNT1H = 0B, TCNT1L = DC
                                 	; Activar Máscara, luego activar Bandera de INT
                                 
000083 e004                      	ldi		R16, (1 << CS12) |(0 << CS11) | (0 << CS10)
000084 9300 0081                 	STS		TCCR1B, R16
000086 e001                      	LDI		R16, (1 << TOIE1) 
000087 9300 006f                 	STS		TIMSK1, R16; HABILITAR INTERRÚPCIONES.  (TIMISK1)
000089 e00b                      	ldi		R16, T1VALUE_H
00008a 9300 0085                 	sts		TCNT1H, R16
00008c ed0c                      	ldi		R16, T1VALUE_L
00008d 9300 0084                 	STS		TCNT1L, R16
                                 
                                 /****************************************************************************************************************************/
                                 ; Habilitamos las interrupciones de PINCHANGE de PORTC:
                                 ;Aqui es donde tengo toods mis bottoncitos., bueno la mayoria por ahora, puesto que aún debo verificar.
                                 
00008f e002                      	LDI		R16, (1 << PCIE1)
000090 9300 0068                     STS		PCICR, R16	
000092 e20c                      	LDI		R16, (1 << SET_SPDT) | (1 << EN0) | (1 << EN_PB)
000093 9300 006c                 	STS		PCMSK1, R16	
                                 /****************************************************************************************************************************/
                                 ; INICIALIZACIÓN DE CONTADORES y valores iniciales:
                                 
                                 	; Valores iniciales de variables de conteo
                                 	; Registros de propósito general
000095 e040                      	LDI		msCOUNT0, 0
000096 e050                      	LDI		msCOUNT1, 0
000097 e060                      	LDI		sCOUNT, 0
000098 e070                      	LDI		MODO, 0b00000000					
000099 e081                      	LDI		MUX_SECUENCIA, 0b00000001			; ¡Un transistor debe empezar encendido!; esta es un a correción a la asignación de voltaje inciial.
00009a e094                      	LDI		ENCODER, (1 << PB_LAST)				;PUSHBUTTON empieza no estando apachado
                                 	; R5=0
00009b e000                      	LDI		R16, 0
00009c 2e50                      	MOV		R5, R16	
                                 	; Localidades en RAM
00009d e000                      	LDI		R16, 0
00009e 9300 0101                 	STS		MINUTOS_UNIDADES, R16
0000a0 9300 0102                 	STS		MINUTOS_DECENAS, R16
0000a2 9300 0103                 	STS		HORAS_UNIDADES, R16
0000a4 9300 0104                 	STS		HORAS_DECENAS, R16
0000a6 e001                      	LDI		R16, 1
0000a7 9300 0105                 	STS		DIAS_UNIDADES, R16				; ¡Días debe empezar en 01!
0000a9 e000                      	LDI		R16, 0
0000aa 9300 0106                 	STS		DIAS_DECENAS, R16
0000ac e001                      	LDI		R16, 1
0000ad 9300 0107                 	STS		MESES_UNIDADES, R16				; ¡Meses debe empezar en 01! NO HAY MESES CERO :,D
                                 	
0000af e000                      	LDI		R16, 0
0000b0 9300 0108                 	STS		MESES_DECENAS, R16				; aqui sí aplicamos un cero
                                 	;Idea para trabajar la concordancia de la alarma, verificación.
                                 
                                 	;LDI		R16, (1 << ALARM_VALID) | (0 << ALARM_ACTIVE) | (0 << ALARM_SET)
                                 	;STS		ALARM_REGISTER, R16
                                 
0000b2 e000                      	LDI		R16, 0
